// Layout helper - injects navbar and sidebar into pages
document.addEventListener('DOMContentLoaded', function() {
    // Inject navbar
    const navbarContainer = document.getElementById('navbar');
    if (navbarContainer) {
        fetch('components/navbar.html')
            .then(response => response.text())
            .then(html => {
                navbarContainer.innerHTML = html;
                // Initialize navbar JS after injection
                const navbarScript = document.createElement('script');
                navbarScript.src = 'js/navbar.js';
                navbarScript.defer = true;
                document.body.appendChild(navbarScript);
            })
            .catch(err => console.error('Failed to load navbar:', err));
    }
    
    // Inject sidebar
    const sidebarContainer = document.getElementById('sidebar');
    if (sidebarContainer) {
        fetch('components/sidebar.html')
            .then(response => response.text())
            .then(html => {
                sidebarContainer.innerHTML = html;
                // Initialize sidebar JS after injection
                const sidebarScript = document.createElement('script');
                sidebarScript.src = 'js/sidebar.js';
                sidebarScript.defer = true;
                document.body.appendChild(sidebarScript);
            })
            .catch(err => console.error('Failed to load sidebar:', err));
    }
});